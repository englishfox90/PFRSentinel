<ResourceDictionary
    x:Class="PFRSentinel.NINA.SentinelSequenceItems.SentinelConditionsTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PFRSentinel.NINA.SentinelSequenceItems"
    xmlns:mini="clr-namespace:NINA.View.Sequencer.MiniSequencer;assembly=NINA.Sequencer"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">

    <!--
        Templates for the imaging-conditions trigger and loop condition.

        Self-contained on purpose: no StaticResource and no converter anywhere inside
        the DataTemplates, so a missing key can never make an item render as nothing.
        The limit editors are repeated per template rather than shared for the same
        reason. Nullable limits bind with TargetNullValue='' so an empty box means
        "not used" both ways.

        Icons: the aperture mark with a badge cut out of it, built exactly like the
        Start/Stop icons in SentinelTemplates.xaml (see the note there on why the cut is
        CombinedGeometry/Exclude, not a fill rule). Keys are plugin-prefixed because
        every plugin's dictionaries share one scope.
    -->

    <!--  Pause on bad conditions - aperture + pause bars.  -->
    <GeometryGroup x:Key="PFRSentinel_PauseSVG" FillRule="Nonzero">
        <CombinedGeometry GeometryCombineMode="Exclude">
            <CombinedGeometry.Geometry1>
                <GeometryGroup FillRule="Nonzero">
                    <GeometryGroup.Transform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1.30159" ScaleY="1.30159" />
                            <TranslateTransform X="-256.41" Y="-256.41" />
                        </TransformGroup>
                    </GeometryGroup.Transform>
                        <PathGeometry Figures="M449.46,383.68h90.44l-102.61-177.73c-55.56,13.45-106.53,41.91-147.98,83.36-27.7,27.7-49.59,59.65-65.09,94.37h225.25Z" />
                        <PathGeometry Figures="M591.87,393.69l45.21,78.31,102.56-177.63c-1.63-1.7-3.27-3.39-4.94-5.06-59.48-59.48-138.57-92.24-222.7-92.24-10.99,0-21.9.57-32.68,1.68l112.55,194.94s0,.01,0,.02Z" />
                        <PathGeometry Figures="M257.04,696.96l112.56-194.96,45.22-78.32h-205.25c-8.23,28.33-12.51,58-12.51,88.32,0,67.38,21.04,131.53,59.98,184.96Z" />
                        <PathGeometry Figures="M432.15,630.34s0,0,0-.01l-45.22-78.32-102.56,177.63c1.63,1.7,3.27,3.39,4.94,5.06,59.48,59.48,138.57,92.24,222.7,92.24,10.99,0,21.9-.57,32.69-1.68l-112.54-194.92Z" />
                        <PathGeometry Figures="M766.96,327.04l-112.56,194.96-45.22,78.32h205.25c8.23-28.33,12.51-58,12.51-88.32,0-67.38-21.04-131.53-59.98-184.96Z" />
                        <PathGeometry Figures="M574.57,640.32s-.02,0-.03,0h-90.44l102.61,177.73c55.56-13.46,106.53-41.91,147.98-83.36,27.7-27.7,49.59-59.65,65.09-94.37h-225.22Z" />
                        <EllipseGeometry Center="512,512" RadiusX="59.16" RadiusY="59.16" />
                </GeometryGroup>
            </CombinedGeometry.Geometry1>
            <CombinedGeometry.Geometry2>
                <EllipseGeometry Center="757,757" RadiusX="272" RadiusY="272" />
            </CombinedGeometry.Geometry2>
        </CombinedGeometry>
        <RectangleGeometry Rect="627,617,95,280" RadiusX="24" RadiusY="24" />
        <RectangleGeometry Rect="792,617,95,280" RadiusX="24" RadiusY="24" />
    </GeometryGroup>

    <!--  Loop while conditions OK - aperture + check mark.  -->
    <GeometryGroup x:Key="PFRSentinel_LoopSVG" FillRule="Nonzero">
        <CombinedGeometry GeometryCombineMode="Exclude">
            <CombinedGeometry.Geometry1>
                <GeometryGroup FillRule="Nonzero">
                    <GeometryGroup.Transform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1.30159" ScaleY="1.30159" />
                            <TranslateTransform X="-256.41" Y="-256.41" />
                        </TransformGroup>
                    </GeometryGroup.Transform>
                        <PathGeometry Figures="M449.46,383.68h90.44l-102.61-177.73c-55.56,13.45-106.53,41.91-147.98,83.36-27.7,27.7-49.59,59.65-65.09,94.37h225.25Z" />
                        <PathGeometry Figures="M591.87,393.69l45.21,78.31,102.56-177.63c-1.63-1.7-3.27-3.39-4.94-5.06-59.48-59.48-138.57-92.24-222.7-92.24-10.99,0-21.9.57-32.68,1.68l112.55,194.94s0,.01,0,.02Z" />
                        <PathGeometry Figures="M257.04,696.96l112.56-194.96,45.22-78.32h-205.25c-8.23,28.33-12.51,58-12.51,88.32,0,67.38,21.04,131.53,59.98,184.96Z" />
                        <PathGeometry Figures="M432.15,630.34s0,0,0-.01l-45.22-78.32-102.56,177.63c1.63,1.7,3.27,3.39,4.94,5.06,59.48,59.48,138.57,92.24,222.7,92.24,10.99,0,21.9-.57,32.69-1.68l-112.54-194.92Z" />
                        <PathGeometry Figures="M766.96,327.04l-112.56,194.96-45.22,78.32h205.25c8.23-28.33,12.51-58,12.51-88.32,0-67.38-21.04-131.53-59.98-184.96Z" />
                        <PathGeometry Figures="M574.57,640.32s-.02,0-.03,0h-90.44l102.61,177.73c55.56-13.46,106.53-41.91,147.98-83.36,27.7-27.7,49.59-59.65,65.09-94.37h-225.22Z" />
                        <EllipseGeometry Center="512,512" RadiusX="59.16" RadiusY="59.16" />
                </GeometryGroup>
            </CombinedGeometry.Geometry1>
            <CombinedGeometry.Geometry2>
                <EllipseGeometry Center="757,757" RadiusX="272" RadiusY="272" />
            </CombinedGeometry.Geometry2>
        </CombinedGeometry>
        <PathGeometry Figures="M 600,770 L 670,700 L 730,760 L 880,610 L 950,680 L 730,900 Z" />
    </GeometryGroup>

    <!--  Detail views. DataType must be the item type.  -->
    <DataTemplate DataType="{x:Type local:SentinelConditionsTrigger}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel>
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Margin="0,2,12,2" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="Min star ratio" />
                            <TextBox
                                MinWidth="40"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding MinStarRatio, TargetNullValue=''}"
                                TextAlignment="Right"
                                ToolTip="Lowest star count as a fraction of this rig's clear-sky count, e.g. 0.5. Not used while Sentinel is still learning this sky. Empty = not used." />
                        </StackPanel>
                        <StackPanel Margin="0,2,12,2" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="Max cloud %" />
                            <TextBox
                                MinWidth="40"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding MaxCloudCoverPct, TargetNullValue=''}"
                                TextAlignment="Right"
                                ToolTip="Highest cloud cover, percent. Not used while Sentinel is still learning this sky. Empty = not used." />
                        </StackPanel>
                        <StackPanel Margin="0,2,12,2" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="Star drop %" />
                            <TextBox
                                MinWidth="40"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding MaxStarDropPct, TargetNullValue=''}"
                                TextAlignment="Right"
                                ToolTip="Star count drop against recent frames, percent: 40 means a drop of 40 % or more is bad. Empty = not used." />
                        </StackPanel>
                        <StackPanel Margin="0,2,12,2" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="FWHM rise %" />
                            <TextBox
                                MinWidth="40"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding MaxFwhmRisePct, TargetNullValue=''}"
                                TextAlignment="Right"
                                ToolTip="FWHM rise against the night median, percent: 30 means 30 % or more larger is bad. Empty = not used." />
                        </StackPanel>
                        <StackPanel Margin="0,2,12,2" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="Max FWHM (″)" />
                            <TextBox
                                MinWidth="40"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding MaxFwhmArcsec, TargetNullValue=''}"
                                TextAlignment="Right"
                                ToolTip="Highest pier-camera FWHM in arcseconds (needs Sentinel's plate scale). Empty = not used." />
                        </StackPanel>
                        <StackPanel Margin="0,2,12,2" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="Max FWHM (px)" />
                            <TextBox
                                MinWidth="40"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding MaxFwhmPx, TargetNullValue=''}"
                                TextAlignment="Right"
                                ToolTip="Highest pier-camera FWHM in pixels. Empty = not used." />
                        </StackPanel>
                        <CheckBox
                            Margin="0,2,12,2"
                            VerticalAlignment="Center"
                            Content="Require roof Open"
                            IsChecked="{Binding RequireRoofOpen}"
                            ToolTip="Treat anything but a roof reading Open as bad, whatever Sentinel's own roof setting." />
                        <CheckBox
                            Margin="0,2,12,2"
                            VerticalAlignment="Center"
                            Content="No verdict = bad"
                            IsChecked="{Binding TreatNoVerdictAsBad}"
                            ToolTip="When Sentinel is unreachable, rejects the token, is stale, warming up or has conditions switched off: on treats that as bad, off carries on imaging." />
                        <CheckBox
                            Margin="0,2,12,2"
                            VerticalAlignment="Center"
                            Content="Only before exposures"
                            IsChecked="{Binding OnlyBeforeExposures}"
                            ToolTip="Check only before an exposure, so a park or warm-up after the imaging is never held back." />
                        <StackPanel Margin="0,2,12,2" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="Settle (s)" />
                            <TextBox
                                MinWidth="40"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding SettleSeconds}"
                                TextAlignment="Right"
                                ToolTip="How long conditions must stay OK before imaging resumes. 0-3600 seconds." />
                        </StackPanel>
                        <StackPanel Margin="0,2,12,2" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="Max wait (min)" />
                            <TextBox
                                MinWidth="40"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding MaxWaitMinutes}"
                                TextAlignment="Right"
                                ToolTip="Longest pause. 0 waits as long as it takes; a long wait also holds back the instructions after it." />
                        </StackPanel>
                        <CheckBox
                            Margin="0,2,12,2"
                            VerticalAlignment="Center"
                            Content="Fail on timeout"
                            IsChecked="{Binding FailOnTimeout}"
                            ToolTip="When the maximum wait runs out: ticked fails the trigger, unticked carries on with the sequence." />
                    </WrapPanel>
                    <TextBlock
                        Margin="0,3,0,0"
                        Foreground="#FF8A8A8A"
                        Text="{Binding ConditionsSummary}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

