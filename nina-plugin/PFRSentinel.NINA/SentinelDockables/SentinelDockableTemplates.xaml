<ResourceDictionary
    x:Class="PFRSentinel.NINA.SentinelDockables.SentinelDockableTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PFRSentinel.NINA.SentinelDockables">

    <!--
        Key MUST be the dockable's fully qualified type name + "_Dockable".

        No converters and no StaticResource lookups anywhere below: the view model
        hands over Visibility and Brush values already resolved. A missing resource
        key inside a DataTemplate throws at load and the panel renders as nothing,
        with no error the operator can see.
    -->
    <DataTemplate x:Key="PFRSentinel.NINA.SentinelDockables.SentinelDockable_Dockable">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="60" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Live frame. Dimmed by FrameOpacity the moment Sentinel calls it stale.  -->
            <Border
                Grid.Row="0"
                Background="#22808080"
                CornerRadius="2">
                <Grid>
                    <Image
                        Opacity="{Binding FrameOpacity}"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="{Binding Frame}"
                        Stretch="Uniform"
                        StretchDirection="DownOnly"
                        Visibility="{Binding FrameVisibility}" />

                    <Border
                        Margin="4"
                        Padding="6,1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#CC101010"
                        CornerRadius="2"
                        Visibility="{Binding StaleVisibility}">
                        <TextBlock
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#FFFFB300"
                            Text="STALE" />
                    </Border>

                    <TextBlock
                        Margin="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#FF8A8A8A"
                        Text="{Binding PlaceholderText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{Binding PlaceholderVisibility}" />
                </Grid>
            </Border>

            <TextBlock
                Grid.Row="1"
                Margin="1,5,1,0"
                FontSize="11"
                Foreground="{Binding FrameStatusBrush}"
                Text="{Binding FrameStatusText}"
                TextTrimming="CharacterEllipsis" />

            <StackPanel
                Grid.Row="2"
                Margin="1,5,1,0"
                Orientation="Horizontal">
                <TextBlock
                    FontSize="11"
                    Foreground="#FF8A8A8A"
                    Text="Health: " />
                <TextBlock
                    FontSize="11"
                    FontWeight="Bold"
                    Foreground="{Binding HealthBrush}"
                    Text="{Binding HealthStatusText}" />
            </StackPanel>

            <!--  Sentinel's own reason strings, rendered verbatim.  -->
            <ItemsControl
                Grid.Row="3"
                Margin="1,2,1,0"
                ItemsSource="{Binding HealthReasons}"
                Visibility="{Binding HealthReasonsVisibility}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Margin="0,1,0,0"
                            FontSize="11"
                            Foreground="#FF8A8A8A"
                            Text="{Binding}"
                            TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--
                Two columns when the dock is wide enough, stacked when it is not: a
                WrapPanel moves the target column under the statistics instead of
                squeezing either. The row template is repeated rather than shared,
                because a shared one would be a StaticResource lookup (see the top).
            -->
            <WrapPanel
                Grid.Row="4"
                Margin="1,6,1,0"
                Orientation="Horizontal">

                <!--  Read-only statistics, straight from /status. No derived figures.  -->
                <ItemsControl
                    Width="250"
                    Margin="0,0,16,6"
                    ItemsSource="{Binding Statistics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    FontSize="11"
                                    Foreground="#FF6E6E6E"
                                    Text="{Binding Label}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="11"
                                    Foreground="#FF8A8A8A"
                                    Text="{Binding Value}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  What the plugin last sent to Sentinel's all-sky overlay (SentinelTargetRows).  -->
                <StackPanel Width="280">
                    <ItemsControl ItemsSource="{Binding TargetRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        FontSize="11"
                                        Foreground="#FF6E6E6E"
                                        Text="{Binding Label}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="11"
                                        Foreground="#FF8A8A8A"
                                        Text="{Binding Value}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="#FFFFB300"
                        Text="{Binding TargetProblemText}"
                        TextWrapping="Wrap"
                        Visibility="{Binding TargetProblemVisibility}" />
                </StackPanel>
            </WrapPanel>

            <TextBlock
                Grid.Row="5"
                Margin="1,5,1,0"
                FontSize="11"
                Foreground="{Binding LinkNoticeBrush}"
                Text="{Binding LinkNoticeText}"
                TextWrapping="Wrap"
                Visibility="{Binding LinkNoticeVisibility}" />

            <!--
                IsEnabled is bound rather than left to ICommand.CanExecute so the
                buttons stay dead for the whole time a wait:true command is in flight.
            -->
            <StackPanel
                Grid.Row="6"
                Margin="0,7,0,0"
                Orientation="Horizontal">
                <Button
                    Width="70"
                    Command="{Binding StartCommand}"
                    Content="Start"
                    IsEnabled="{Binding CanIssueCommands}"
                    ToolTip="Start capture in Sentinel's configured mode." />
                <Button
                    Width="70"
                    Margin="5,0,0,0"
                    Command="{Binding StopCommand}"
                    Content="Stop"
                    IsEnabled="{Binding CanIssueCommands}"
                    ToolTip="Stop capture." />
                <Button
                    Width="80"
                    Margin="5,0,0,0"
                    Command="{Binding ReconnectCommand}"
                    Content="Reconnect"
                    ToolTip="Re-read Sentinel's configuration and poll now." />
            </StackPanel>

            <StackPanel Grid.Row="7" Margin="1,5,1,0">
                <!--
                    Why Start/Stop are dead. Bound to its own always-populated property
                    rather than reusing a notice, so there is no state in which the
                    buttons are greyed and this line is blank.
                -->
                <TextBlock
                    Margin="0,0,0,4"
                    FontSize="11"
                    Foreground="#FFFFB300"
                    Text="{Binding CommandsDisabledText}"
                    TextWrapping="Wrap"
                    Visibility="{Binding CommandsDisabledVisibility}" />
                <TextBlock
                    FontSize="11"
                    Foreground="{Binding CommandMessageBrush}"
                    Text="{Binding CommandMessageText}"
                    TextWrapping="Wrap"
                    Visibility="{Binding CommandMessageVisibility}" />
                <!--  Turns amber when an options override is in force.  -->
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="10"
                    Foreground="{Binding EndpointBrush}"
                    Text="{Binding EndpointText}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- PFR Sentinel aperture mark, extracted verbatim from assets/Icon.svg
         (six blade paths + the centre dot). NINA fills ImageGeometry with the
         theme foreground brush, so this renders as a monochrome silhouette -
         the icon's colour cannot carry through. Nonzero fill rule stops the
         centre dot punching a hole where it meets the blades. -->
    <GeometryGroup x:Key="PFRSentinel_DockableSVG" FillRule="Nonzero">
        <PathGeometry Figures="M449.46,383.68h90.44l-102.61-177.73c-55.56,13.45-106.53,41.91-147.98,83.36-27.7,27.7-49.59,59.65-65.09,94.37h225.25Z" />
        <PathGeometry Figures="M591.87,393.69l45.21,78.31,102.56-177.63c-1.63-1.7-3.27-3.39-4.94-5.06-59.48-59.48-138.57-92.24-222.7-92.24-10.99,0-21.9.57-32.68,1.68l112.55,194.94s0,.01,0,.02Z" />
        <PathGeometry Figures="M257.04,696.96l112.56-194.96,45.22-78.32h-205.25c-8.23,28.33-12.51,58-12.51,88.32,0,67.38,21.04,131.53,59.98,184.96Z" />
        <PathGeometry Figures="M432.15,630.34s0,0,0-.01l-45.22-78.32-102.56,177.63c1.63,1.7,3.27,3.39,4.94,5.06,59.48,59.48,138.57,92.24,222.7,92.24,10.99,0,21.9-.57,32.69-1.68l-112.54-194.92Z" />
        <PathGeometry Figures="M766.96,327.04l-112.56,194.96-45.22,78.32h205.25c8.23-28.33,12.51-58,12.51-88.32,0-67.38-21.04-131.53-59.98-184.96Z" />
        <PathGeometry Figures="M574.57,640.32s-.02,0-.03,0h-90.44l102.61,177.73c55.56-13.46,106.53-41.91,147.98-83.36,27.7-27.7,49.59-59.65,65.09-94.37h-225.22Z" />
        <EllipseGeometry Center="512.0,512.0" RadiusX="59.16" RadiusY="59.16" />
    </GeometryGroup>
</ResourceDictionary>
